# Hamsa Voice Agent Configuration
# All of these can also be set at runtime from the in-app Settings panel.
VITE_HAMSA_API_KEY=your_hamsa_api_key_here
VITE_HAMSA_AGENT_ID=your_voice_agent_id_here

# Deployment region of your Hamsa project: eu (default) or uae
VITE_HAMSA_REGION=eu

# Names injected into the agent prompt
VITE_KIOSK_PERSONA_NAME=Delicious Assistant
VITE_KIOSK_VENDOR_NAME=Delicious
